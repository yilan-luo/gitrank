{
  "permissions": {
    "allow": [
      "PowerShell(openspec new *)",
      "Bash(pip list *)",
      "Bash(where sqlite3.dll)",
      "Read(//d/Miniconda/DLLs/**)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "PowerShell(py *)",
      "Bash(python -m pytest tests/ -v --tb=short)",
      "Bash(where python *)",
      "Bash(python -c ' *)",
      "Bash(python *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/skills/comet/scripts/comet-hook-guard.sh"
          }
        ]
      }
    ]
  }
}
